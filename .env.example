# The Ashgrove Times — local secrets. Copy to .env and fill in.
# .env is gitignored. NEVER commit a real webhook URL; this repo is public.
#
# Get a URL: Channel Settings -> Integrations -> Webhooks -> New Webhook
# -> Copy Webhook URL. A webhook can only post to its own channel, which
# is what makes it safe to hand to a scheduled cloud run.
#
# The cloud routine does not read this file — it receives the URL in its
# task prompt.

# The live channel the paper posts to.
DISCORD_WEBHOOK_URL=

# Optional. Used only by `post_discord.py --test` for rehearsals.
DISCORD_TEST_WEBHOOK_URL=

# There is deliberately no Sports & Sportsman webhook. That paper has not
# posted to Discord since 2026-08-26 - Home and the nav buttons reach it and
# the Times digest carries its tease - and the code that could use one was
# deleted on 2026-09-02. One paper posts; one credential exists.
